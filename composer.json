{
    "name": "starlight93/laravel-smart-api",
    "description": "Restful API Generator",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Starlight93\\LaravelSmartApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "starlight93",
            "email": "mail.firmansyah93@gmail.com",
            "role": "Author"
        },
        {
            "name": "Claude (Anthropic)",
            "homepage": "https://claude.com/claude-code",
            "role": "Contributor"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "staudenmeir/laravel-cte": "^1.13",
        "doctrine/dbal": "^3.6",
        "jfcherng/php-diff": "^6.15",
        "tymon/jwt-auth": "^2.2",
        "rap2hpoutre/laravel-log-viewer": "^3.1",
        "kitloong/laravel-migrations-generator": "^7.4"
    },
    "suggest": {
        "laravel/sanctum": "Set API_AUTH_DRIVER=sanctum untuk memakai guard sanctum aplikasi host",
        "laravel/passport": "Set API_AUTH_DRIVER=passport untuk memakai guard passport aplikasi host"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Starlight93\\LaravelSmartApi\\ApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
